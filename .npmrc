; This project is public and has zero dependencies. Pin the public registry so a
; developer's machine-wide npm config can never resolve anything here.
;
; NOTE: npm ranks env above project config, so an npm_config_registry environment
; variable still wins over this file locally. Install with that variable unset if
; your machine sets one. CI sets no such variable, so this file governs there.
registry=https://registry.npmjs.org/
